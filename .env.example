# ==========================================
# IntelliMaint AI — Environment Configuration
# ==========================================
# Copy this file to '.env' and adjust the variables as needed.
# DO NOT commit real secrets or credentials to version control.

# Application Environment
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-token-at-least-32-chars

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Database Configuration
# Enterprise Primary: PostgreSQL
# Example: postgresql+psycopg2://postgres:your_password@localhost:5432/intellimaint_db
# Local Development Fallback: SQLite
DATABASE_URL=sqlite:///./intellimaint.db

# Frontend (Streamlit) Configuration
STREAMLIT_SERVER_PORT=8501
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Logging
LOG_LEVEL=INFO
